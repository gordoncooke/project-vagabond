[Unit]
Description=Offline Emergency Library Admin Interface
After=network.target

[Service]
Type=simple
User=library-admin
Group=library-admin
WorkingDirectory=/opt/offline-library-admin
ExecStart=/opt/offline-library-admin/venv/bin/gunicorn \
    --bind 127.0.0.1:5050 \
    --workers 1 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
