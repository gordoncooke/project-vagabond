#!/usr/bin/env bash
# AUTO: prefer HOME Wi-Fi; use OfflineLibrary AP when unavailable.
# Event-driven NetworkManager monitoring replaces periodic 10-second polling.

set -u -o pipefail

. /etc/offline-library/network.conf

IFACE="$WIFI_INTERFACE"
FAILOVER_GRACE=15
AP_RETRY_INTERVAL=300

log() {
    echo "library-auto: $*"
}

# Identify connections by UUID rather than profile display name.
active_uuid() {
    nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null |
        awk -F: -v iface="$IFACE" '$2 == iface {print $1; exit}'
}

home_active() {
    [[ "$(active_uuid)" == "$HOME_PROFILE_UUID" ]]
}

ap_active() {
    [[ "$(active_uuid)" == "$AP_PROFILE_UUID" ]]
}

try_home() {
    log "Trying HOME connection..."
    nmcli --wait 20 connection up uuid "$HOME_PROFILE_UUID" \
        ifname "$IFACE" >/dev/null 2>&1
}

start_ap() {
    log "Starting OfflineLibrary hotspot..."
    nmcli --wait 20 connection up uuid "$AP_PROFILE_UUID" \
        ifname "$IFACE" >/dev/null 2>&1
}

ap_clients() {
    iw dev "$IFACE" station dump 2>/dev/null |
        awk '/^Station / { n++ } END { print n+0 }'
}

# Set whenever HOTSPOT starts or a HOME retry is attempted.
last_ap_probe=$(date +%s)

# Recover after losing the active network connection.
recover_connection() {

    # NetworkManager may have already recovered.
    if home_active || ap_active; then
        return 0
    fi

    log "Connection lost; waiting ${FAILOVER_GRACE}s."

    sleep "$FAILOVER_GRACE"

    if home_active; then
        log "HOME recovered automatically."
        return 0
    fi

    if ap_active; then
        log "HOTSPOT active."
        return 0
    fi

    if try_home; then
        log "HOME reconnected."
        return 0
    fi

    if start_ap; then
        log "Failover to HOTSPOT successful."
        last_ap_probe=$(date +%s)
        return 0
    fi

    log "ERROR: Cannot establish HOME or HOTSPOT."
    exit 1
}

# Periodically retry HOME while operating as a hotspot.
retry_home_from_ap() {

    last_ap_probe=$(date +%s)

    # Do not interrupt connected hotspot users.
    local clients

    if ! clients=$(ap_clients); then
        log "Warning: Unable to check HOTSPOT clients; skipping retry."
        return 0
    fi

    if (( clients > 0 )); then
        return 0
    fi

    log "No HOTSPOT clients; trying HOME."

    if try_home; then
        log "HOME restored."
        return 0
    fi

    if start_ap; then
        log "HOME unavailable; HOTSPOT restored."
        last_ap_probe=$(date +%s)
        return 0
    fi

    log "ERROR: Could not restore HOTSPOT."
    exit 1
}

# Start the NetworkManager device-event monitor.
#
# coproc provides a file descriptor from which Bash can read
# events without periodically launching nmcli.
#
# stdbuf ensures events are delivered promptly through the pipe.

coproc NM_MONITOR {
    exec stdbuf -oL nmcli device monitor "$IFACE"
}

monitor_fd=${NM_MONITOR[0]}
monitor_pid=$NM_MONITOR_PID

cleanup() {
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 0' TERM INT

# Initial connection selection.
nmcli radio wifi on || log "Warning: could not enable Wi-Fi radio"

log "Event-driven AUTO mode starting."

if home_active; then
    log "HOME already active."

elif try_home; then
    log "HOME connected."

elif start_ap; then
    log "HOME unavailable; HOTSPOT active."
    last_ap_probe=$(date +%s)

else
    log "ERROR: Could not start HOME or HOTSPOT."
    exit 1
fi

# Main event-driven control loop.
while true; do

    # =====================================================
    # HOME MODE
    # =====================================================
    #
    # Block indefinitely waiting for NetworkManager events.
    # No periodic polling while HOME remains connected.

    if home_active; then

        if IFS= read -r -u "$monitor_fd" event; then

            log "Network event: $event"

            # Respond only if the connection was actually lost.
            if ! home_active && ! ap_active; then
                recover_connection
            fi

        else
            log "ERROR: NetworkManager event monitor stopped."
            exit 1
        fi

        continue
    fi

    # =====================================================
    # HOTSPOT MODE
    # =====================================================
    #
    # Wait for an event or the next five-minute HOME retry.
    # Do not poll every 10 seconds.

    if ap_active; then

        now=$(date +%s)
        next_probe=$((last_ap_probe + AP_RETRY_INTERVAL))
        wait_seconds=$((next_probe - now))

        # Time to consider another HOME attempt.
        if (( wait_seconds <= 0 )); then
            retry_home_from_ap
            continue
        fi

        # Wait for either a NetworkManager event or timeout.
        if IFS= read -r -t "$wait_seconds" \
            -u "$monitor_fd" event; then

            log "Network event: $event"

            if ! home_active && ! ap_active; then
                recover_connection
            fi

        else
            result=$?

            # Bash read -t returns >128 on timeout.
            # EOF or other read failure means the monitor ended.
            if (( result <= 128 )); then
                log "ERROR: NetworkManager event monitor stopped."
                exit 1
            fi

            # Timeout is expected: the next loop checks
            # whether the scheduled HOME retry is due.
        fi

        continue
    fi

    # =====================================================
    # NO RECOGNIZED CONNECTION
    # =====================================================
    #
    # Recover from unexpected disconnection or transition.

    recover_connection

done