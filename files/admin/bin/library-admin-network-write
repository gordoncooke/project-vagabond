#!/usr/bin/env python3

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME_PROFILE = "netplan-wlan0-Cooke-home-wifi"
HOTSPOT_PROFILE = "OfflineLibrary-AP"

HOME_NETPLAN = Path(
    "/etc/netplan/90-NM-07221bc3-3338-360f-965b-9abeaeeca19c.yaml"
)

HOTSPOT_FILE = Path(
    "/etc/NetworkManager/system-connections/OfflineLibrary-AP.nmconnection"
)

MAX_INPUT = 4096


def fail(message):
    print(json.dumps({
        "ok": False,
        "error": message
    }))
    sys.exit(1)


def run(args):
    result = subprocess.run(
        args,
        capture_output=True,
        text=True,
        timeout=30
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip()
            or result.stdout.strip()
            or f"Command failed: {args[0]}"
        )

    return result.stdout.strip()


def get_active_connection():
    try:
        return run([
            "nmcli",
            "-g",
            "GENERAL.CONNECTION",
            "device",
            "show",
            "wlan0"
        ])
    except Exception:
        return ""


def schedule_reconnect(profile):
    subprocess.Popen(
        [
            "/bin/sh",
            "-c",
            'sleep 4; exec /usr/bin/nmcli --wait 20 '
            'connection up id "$1" ifname wlan0',
            "offline-library-network-apply",
            profile
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )


def write_atomic(path, text, mode=0o600):
    fd, temp_name = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
        text=True
    )

    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())

        os.chmod(temp_name, mode)
        os.chown(temp_name, 0, 0)
        os.replace(temp_name, path)

    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def update_home(ssid, password):
    import yaml

    original = HOME_NETPLAN.read_text()
    data = yaml.safe_load(original)

    wlan = data["network"]["wifis"]["wlan0"]
    aps = wlan["access-points"]

    if len(aps) != 1:
        raise RuntimeError(
            "HOME netplan profile does not contain exactly one access point."
        )

    old_ssid = next(iter(aps))
    settings = aps.pop(old_ssid)

    settings.setdefault("auth", {})
    settings["auth"]["key-management"] = "psk"
    settings["auth"]["password"] = password

    aps[ssid] = settings

    backup = HOME_NETPLAN.with_suffix(
        HOME_NETPLAN.suffix + ".admin-backup"
    )
    shutil.copy2(HOME_NETPLAN, backup)

    new_text = yaml.safe_dump(
        data,
        sort_keys=False,
        default_flow_style=False
    )

    try:
        write_atomic(HOME_NETPLAN, new_text)
        run(["netplan", "generate"])

    except Exception:
        shutil.copy2(backup, HOME_NETPLAN)
        run(["netplan", "generate"])
        raise


def update_hotspot(ssid, password):
    original = HOTSPOT_FILE.read_text()
    lines = original.splitlines()

    section = None
    saw_ssid = False
    saw_psk = False
    output = []

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped
            output.append(line)
            continue

        if section == "[wifi]" and line.startswith("ssid="):
            output.append(f"ssid={ssid}")
            saw_ssid = True
            continue

        if section == "[wifi-security]" and line.startswith("psk="):
            output.append(f"psk={password}")
            saw_psk = True
            continue

        output.append(line)

    if not saw_ssid:
        raise RuntimeError("Could not find hotspot SSID setting.")

    if not saw_psk:
        raise RuntimeError("Could not find hotspot password setting.")

    backup = HOTSPOT_FILE.with_suffix(
        HOTSPOT_FILE.suffix + ".admin-backup"
    )
    shutil.copy2(HOTSPOT_FILE, backup)

    write_atomic(
        HOTSPOT_FILE,
        "\n".join(output) + "\n"
    )


raw = sys.stdin.read(MAX_INPUT + 1)

if len(raw) > MAX_INPUT:
    fail("Request too large.")

try:
    data = json.loads(raw)
except Exception:
    fail("Invalid request.")

target = data.get("target")
ssid = data.get("ssid")
password = data.get("password")
confirm = data.get("confirm")
dry_run = data.get("dry_run", True)

if target not in ("home", "hotspot"):
    fail("Invalid network target.")

if not isinstance(ssid, str):
    fail("SSID is required.")

if not isinstance(password, str):
    fail("Password is required.")

if not isinstance(confirm, str):
    fail("Password confirmation is required.")

ssid = ssid.strip()

if not ssid:
    fail("SSID cannot be blank.")

if len(ssid.encode("utf-8")) > 32:
    fail("SSID must be 32 bytes or fewer.")

if "\n" in ssid or "\r" in ssid or "\x00" in ssid:
    fail("SSID contains invalid characters.")

if password != confirm:
    fail("Passwords do not match.")

if len(password) < 8 or len(password) > 63:
    fail("Wi-Fi password must be 8 to 63 characters.")

if any(ord(c) < 32 or ord(c) > 126 for c in password):
    fail("Wi-Fi password must use printable ASCII characters.")

if dry_run:
    print(json.dumps({
        "ok": True,
        "dry_run": True,
        "target": target,
        "ssid": ssid,
        "message": "Validation successful. No changes made."
    }))
    sys.exit(0)

try:
    active_before = get_active_connection()

    if target == "home":
        update_home(ssid, password)
        profile = HOME_PROFILE
    else:
        update_hotspot(ssid, password)
        profile = HOTSPOT_PROFILE

    if target == "home":
        run([
            "nmcli",
            "connection",
            "load",
            "/run/NetworkManager/system-connections/"
            "netplan-wlan0-Cooke-home-wifi.nmconnection"
        ])
    else:
        run([
            "nmcli",
            "connection",
            "load",
            "/etc/NetworkManager/system-connections/"
            "OfflineLibrary-AP.nmconnection"
        ])

    reconnect_scheduled = (active_before == profile)

    if reconnect_scheduled:
        schedule_reconnect(profile)

    print(json.dumps({
        "ok": True,
        "dry_run": False,
        "target": target,
        "profile": profile,
        "ssid": ssid,
        "reconnect_scheduled": reconnect_scheduled,
        "message": "Settings saved."
    }))

except Exception as e:
    fail(str(e))
